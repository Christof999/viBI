# --- Server-side (Vercel Environment Variables) ---
# Google Gemini API key. Erstellen unter https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modell-Identifier. "gemini-3.0-pro" wenn verfügbar, sonst z.B. "gemini-2.5-pro" / "gemini-2.5-flash".
GEMINI_MODEL=gemini-3.0-pro

# --- Client-side (mit VITE_ Präfix, im Browser sichtbar) ---
# URL des lokalen Helper-Service (läuft auf dem Windows-PC des Users).
VITE_HELPER_URL=http://localhost:7321

# Default-Verzeichnis für PBIP-Exports auf dem Windows-PC.
VITE_DEFAULT_PBIP_DIR=C:\\PowerBI\\viBI
