# Port of the local helper service
PORT=7321

# Comma separated list of allowed CORS origins. Wildcards (*) supported.
CORS_ORIGIN=http://localhost:5173,https://*.vercel.app

# Optional explicit path to PowerBI Desktop. Leave empty to auto-detect.
# POWERBI_DESKTOP_PATH=C:\Program Files\Microsoft Power BI Desktop\bin\PBIDesktop.exe

# Whitelisted root folders the helper is allowed to write into.
ALLOWED_WRITE_ROOTS=C:/PowerBI

# --- MCP Servers ---
# Microsoft Fabric / PowerBI MCP (replace command/args with whatever the
# official MS package ships – check the Microsoft docs).
# FABRIC_MCP_COMMAND=npx
# FABRIC_MCP_ARGS=-y @microsoft/mcp-fabric

# Your own custom MCP server (added to the repo later).
# CUSTOM_MCP_COMMAND=node
# CUSTOM_MCP_ARGS=../mcp-server/dist/index.js
